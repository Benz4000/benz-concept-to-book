{
  "schema_version": 1,
  "input_root": "./selected-inputs",
  "selected_inputs": ["manuscript.md","metadata.json","print.json","font.ttf","cover.json","template.json","art.png","barcode.png","render.json","source-use.json"],
  "import": {"manuscript":"manuscript.md","metadata":"metadata.json"},
